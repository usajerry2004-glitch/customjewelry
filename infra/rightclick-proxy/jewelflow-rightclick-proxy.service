[Unit]
Description=JewelFlow RightClick relay proxy
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/rightclick-proxy
EnvironmentFile=/opt/rightclick-proxy/.env
ExecStart=/usr/bin/node /opt/rightclick-proxy/server.js
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
